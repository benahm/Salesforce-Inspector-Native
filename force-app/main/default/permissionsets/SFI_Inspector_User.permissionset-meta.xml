<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SF Inspector Native User</label>
    <description
  >Grants access to SF Inspector Native. Data access still follows the user's own sharing, CRUD and FLS.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>SFI_DescribeService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFI_UserService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFI_ImportService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFI_QueryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFI_RecordService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFI_SearchService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
